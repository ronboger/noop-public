<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-ONLY launcher background (overlays main's dark tile in debug builds): an amber gradient,
     so the side-by-side debug install is unmistakable next to the prod dark icon. Same 108dp
     adaptive-icon canvas; the green loop foreground is unchanged. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="0" android:endY="108"
                android:startColor="#F59E0B" android:endColor="#B45309"/>
        </aapt:attr>
    </path>
</vector>
